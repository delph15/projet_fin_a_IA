{
  "name": "Traitement des factures",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook entrant",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "facture",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Lire le fichier",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [480, 300],
      "parameters": {
        "filePath": "={{ $json.body?.chemin ?? $json.chemin }}"
      }
    },
    {
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Envoyer a l API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/factures/",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "fichier",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Routage par statut",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [960, 300],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.statut }}",
                    "rightValue": "prete",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "prete"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.statut }}",
                    "rightValue": "a_verifier",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "a_verifier"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.statut }}",
                    "rightValue": "doublon",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "doublon"
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Prete a valider",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1200, 120],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "statut",     "value": "prete",   "type": "string" },
            { "id": "a2", "name": "message",    "value": "={{ 'Facture ' + $('Envoyer a l API').item.json.fichier + ' prete (id=' + $('Envoyer a l API').item.json.id + ')' }}", "type": "string" },
            { "id": "a3", "name": "id_facture", "value": "={{ $('Envoyer a l API').item.json.id }}", "type": "number" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "A verifier manuellement",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1200, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "statut",     "value": "a_verifier", "type": "string" },
            { "id": "b2", "name": "message",    "value": "={{ 'ALERTE : Facture ' + $('Envoyer a l API').item.json.fichier + ' a verifier' }}", "type": "string" },
            { "id": "b3", "name": "id_facture", "value": "={{ $('Envoyer a l API').item.json.id }}", "type": "number" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Doublon detecte",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1200, 480],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "statut",     "value": "doublon", "type": "string" },
            { "id": "c2", "name": "message",    "value": "={{ 'DOUBLON : ' + $('Envoyer a l API').item.json.fichier + ' deja en base' }}", "type": "string" },
            { "id": "c3", "name": "id_facture", "value": "={{ $('Envoyer a l API').item.json.id }}", "type": "number" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Repondre prete",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 120],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Envoyer a l API').item.json) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "Repondre a verifier",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Envoyer a l API').item.json) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0011-0011-0011-000000000011",
      "name": "Repondre doublon",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 480],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Envoyer a l API').item.json) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Note architecture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 540],
      "parameters": {
        "content": "## Chemin unique de traitement\n\n1. Streamlit sauvegarde le fichier dans donnees/entrant/\n2. Streamlit POST JSON {filename, chemin} ici\n3. n8n lit le fichier depuis /data/factures/entrant/\n4. n8n envoie a l'API FastAPI en multipart\n5. n8n retourne le JSON de result a Streamlit\n\n**URL test**       : http://localhost:5678/webhook-test/facture\n**URL production** : http://localhost:5678/webhook/facture",
        "height": 200,
        "width": 440,
        "color": 5
      }
    }
  ],
  "connections": {
    "Webhook entrant": {
      "main": [[{ "node": "Lire le fichier", "type": "main", "index": 0 }]]
    },
    "Lire le fichier": {
      "main": [[{ "node": "Envoyer a l API", "type": "main", "index": 0 }]]
    },
    "Envoyer a l API": {
      "main": [[{ "node": "Routage par statut", "type": "main", "index": 0 }]]
    },
    "Routage par statut": {
      "main": [
        [{ "node": "Prete a valider",         "type": "main", "index": 0 }],
        [{ "node": "A verifier manuellement",  "type": "main", "index": 0 }],
        [{ "node": "Doublon detecte",          "type": "main", "index": 0 }]
      ]
    },
    "Prete a valider":         { "main": [[{ "node": "Repondre prete",      "type": "main", "index": 0 }]] },
    "A verifier manuellement": { "main": [[{ "node": "Repondre a verifier", "type": "main", "index": 0 }]] },
    "Doublon detecte":         { "main": [[{ "node": "Repondre doublon",    "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "projet-factures-m1" }
}
