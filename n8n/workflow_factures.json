{
  "name": "Traitement des factures",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook entrant",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 200],
      "parameters": {
        "httpMethod": "POST",
        "path": "facture",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Lire le fichier",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [480, 200],
      "parameters": {
        "filePath": "={{ $json.body?.chemin ?? $json.chemin }}"
      }
    },
    {
      "id": "a1b2c3d4-00ee-00ee-00ee-000000000ee0",
      "name": "Email Trigger IMAP",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [240, 500],
      "parameters": {
        "mailbox": "INBOX",
        "pollTimes": {
          "item": [{ "mode": "everyX", "value": 5, "unit": "minutes" }]
        },
        "options": {
          "downloadAttachments": true,
          "attachmentsPrefix": "attachment_"
        }
      },
      "credentials": {
        "imap": {
          "id": "imap-factures",
          "name": "IMAP Factures"
        }
      }
    },
    {
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Envoyer a l API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 200],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/factures/",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "fichier",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "a1b2c3d4-00ed-00ed-00ed-000000000ed0",
      "name": "Normaliser piece jointe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 500],
      "parameters": {
        "jsCode": "const item = items[0];\nconst binaryKeys = Object.keys(item.binary || {});\nif (binaryKeys.length === 0) {\n  throw new Error('Pas de piece jointe binaire dans cet email. Verifiez que le mail contient bien un fichier PDF ou image en piece jointe.');\n}\nreturn [{\n  json: item.json,\n  binary: { attachment_0: item.binary[binaryKeys[0]] }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-00ef-00ef-00ef-000000000ef0",
      "name": "Envoyer a l API depuis email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 500],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/factures/",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "fichier",
              "inputDataFieldName": "attachment_0"
            }
          ]
        },
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "a1b2c3d4-00f0-00f0-00f0-000000000f00",
      "name": "Resultat email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [960, 500],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "source",     "value": "email",                                               "type": "string" },
            { "id": "e2", "name": "statut",      "value": "={{ $json.statut }}",                                "type": "string" },
            { "id": "e3", "name": "id_facture",  "value": "={{ $json.id }}",                                    "type": "number" },
            { "id": "e4", "name": "message",     "value": "={{ 'Email : facture ' + $json.fichier + ' traitee, statut=' + $json.statut }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Routage par statut",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [960, 200],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.statut }}", "rightValue": "prete",      "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true, "outputKey": "prete"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.statut }}", "rightValue": "a_verifier", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true, "outputKey": "a_verifier"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.statut }}", "rightValue": "doublon",    "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true, "outputKey": "doublon"
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Prete a valider",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1200, 80],
      "parameters": {
        "mode": "manual",
        "assignments": { "assignments": [
          { "id": "a1", "name": "statut",     "value": "prete",   "type": "string" },
          { "id": "a2", "name": "message",    "value": "={{ 'Facture ' + $('Envoyer a l API').item.json.fichier + ' prete (id=' + $('Envoyer a l API').item.json.id + ')' }}", "type": "string" },
          { "id": "a3", "name": "id_facture", "value": "={{ $('Envoyer a l API').item.json.id }}", "type": "number" }
        ]}, "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "A verifier manuellement",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1200, 200],
      "parameters": {
        "mode": "manual",
        "assignments": { "assignments": [
          { "id": "b1", "name": "statut",     "value": "a_verifier", "type": "string" },
          { "id": "b2", "name": "message",    "value": "={{ 'ALERTE : ' + $('Envoyer a l API').item.json.fichier + ' a verifier' }}", "type": "string" },
          { "id": "b3", "name": "id_facture", "value": "={{ $('Envoyer a l API').item.json.id }}", "type": "number" }
        ]}, "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Doublon detecte",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1200, 320],
      "parameters": {
        "mode": "manual",
        "assignments": { "assignments": [
          { "id": "c1", "name": "statut",     "value": "doublon", "type": "string" },
          { "id": "c2", "name": "message",    "value": "={{ 'DOUBLON : ' + $('Envoyer a l API').item.json.fichier }}", "type": "string" },
          { "id": "c3", "name": "id_facture", "value": "={{ $('Envoyer a l API').item.json.id }}", "type": "number" }
        ]}, "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Repondre prete",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 80],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Envoyer a l API').item.json) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "Repondre a verifier",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Envoyer a l API').item.json) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0011-0011-0011-000000000011",
      "name": "Repondre doublon",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 320],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Envoyer a l API').item.json) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Note configuration email",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 700],
      "parameters": {
        "content": "## Configurer la réception email\n\n1. Dans n8n → **Credentials** → **New** → choisir **IMAP**\n2. Remplir :\n   - Host : `imap.gmail.com`\n   - Port : `993`\n   - SSL : activé\n   - User : ton adresse Gmail\n   - Password : **Mot de passe d'application** Gmail\n     (Compte Google → Sécurité → Validation en 2 étapes → Mots de passe d'application)\n3. Nommer la credential **\"IMAP Factures\"**\n4. L'associer au nœud **\"Email Trigger IMAP\"**\n\nLe nœud vérifie la boîte toutes les **5 minutes**.\nToute pièce jointe PDF/image déclenche le pipeline automatiquement.",
        "height": 280,
        "width": 500,
        "color": 3
      }
    }
  ],
  "connections": {
    "Webhook entrant":            { "main": [[{ "node": "Lire le fichier",             "type": "main", "index": 0 }]] },
    "Lire le fichier":            { "main": [[{ "node": "Envoyer a l API",             "type": "main", "index": 0 }]] },
    "Email Trigger IMAP":          { "main": [[{ "node": "Normaliser piece jointe",      "type": "main", "index": 0 }]] },
    "Normaliser piece jointe":     { "main": [[{ "node": "Envoyer a l API depuis email", "type": "main", "index": 0 }]] },
    "Envoyer a l API":             { "main": [[{ "node": "Routage par statut",           "type": "main", "index": 0 }]] },
    "Envoyer a l API depuis email":{ "main": [[{ "node": "Resultat email",              "type": "main", "index": 0 }]] },
    "Routage par statut": {
      "main": [
        [{ "node": "Prete a valider",         "type": "main", "index": 0 }],
        [{ "node": "A verifier manuellement",  "type": "main", "index": 0 }],
        [{ "node": "Doublon detecte",          "type": "main", "index": 0 }]
      ]
    },
    "Prete a valider":         { "main": [[{ "node": "Repondre prete",      "type": "main", "index": 0 }]] },
    "A verifier manuellement": { "main": [[{ "node": "Repondre a verifier", "type": "main", "index": 0 }]] },
    "Doublon detecte":         { "main": [[{ "node": "Repondre doublon",    "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "projet-factures-m1" }
}
