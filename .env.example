# Copier ce fichier en .env et remplir les valeurs
# Ne jamais committer .env dans Git

# Chemin vers l'exécutable Tesseract (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# URL de l'API Ollama (natif Windows)
OLLAMA_URL=http://localhost:11434

# Modèle Ollama utilisé pour l'extraction
OLLAMA_MODELE=qwen2.5:7b

# Chemin vers la base de données SQLite
DB_PATH=donnees/factures.db

# Dossier de dépôt des factures entrantes
DOSSIER_ENTRANT=donnees/dev

# Dossier de conservation des fichiers originaux (affiches dans Streamlit)
DOSSIER_ORIGINAUX=donnees/originaux

# Port local de n8n (l'equipe utilise 5678 par defaut)
N8N_PORT=5678

# Ports locaux de l'API et de l'interface quand elles tournent avec Docker Compose
API_PORT=11435
STREAMLIT_PORT=9400

# URL du webhook n8n (chemin unique de traitement)
# Le port suit N8N_PORT ; changer uniquement N8N_PORT dans .env si necessaire.
N8N_WEBHOOK_URL=http://localhost:${N8N_PORT}/webhook/facture

# URL de l'API pour un lancement hors Docker ; Compose utilise le nom du service "api".
API_URL=http://127.0.0.1:8000
